{
  "name": "openppwr",
  "version": "1.0.0",
  "private": true,
  "description": "OpenPPWR Community open-core packaging compliance platform",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "format:check": "node scripts/validation/format-check.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:unit",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:contract": "npm run test:contract --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:e2e:api": "node scripts/validation/e2e-gate.mjs",
    "test:e2e:browser": "npm run build --workspace=@openppwr/web && node scripts/validation/browser-e2e.mjs en && node scripts/validation/browser-e2e.mjs pl && node scripts/validation/browser-e2e.mjs de",
    "test:e2e": "npm run test:e2e:api && npm run test:e2e:browser",
    "test:e2e:deployed": "node scripts/validation/deployed-e2e.mjs",
    "test:demo:full-e2e": "node scripts/validation/demo-full-e2e.mjs",
    "i18n:gate": "node scripts/validation/i18n-gate.mjs",
    "website:gate": "node scripts/validation/website-gate.mjs",
    "acme:generate": "node scripts/acme/acme-dataset.mjs generate",
    "acme:validate": "node scripts/acme/acme-dataset.mjs validate",
    "acme:export": "node scripts/acme/acme-dataset.mjs export",
    "acme:verify-checksums": "node scripts/acme/acme-dataset.mjs verify-checksums",
    "website:browser": "npm run build --workspace=@openppwr/web && node scripts/validation/website-browser-check.mjs",
    "secret:scan": "node scripts/validation/secret-scan.mjs",
    "gate:sast": "node scripts/validation/sast-scan.mjs",
    "dependency:audit": "npm audit --audit-level=high",
    "release:recovery": "node scripts/release/rehearse-recovery.mjs",
    "release:image:validate": "node --test scripts/release/validate-release-ref.test.mjs scripts/release/verify-registry-mirror.test.mjs scripts/validation/validate-release-workflow.test.mjs scripts/validation/gate-composition.test.mjs scripts/validation/workbench-screens.test.mjs && node scripts/validation/validate-release-workflow.mjs && node scripts/release/validate-supply-chain.mjs",
    "release:image:gate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release/run-supply-chain-gate.ps1",
    "release:image:gate:wsl": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release/run-supply-chain-gate.ps1 -UseWsl",
    "release:clamav:validate": "node scripts/release/validate-clamav.mjs",
    "installer:validate": "node scripts/installer/validate-installer.mjs",
    "installer:docs:gate": "node scripts/validation/installer-docs-gate.mjs",
    "full-gate": "node scripts/validation/full-gate.mjs",
    "deployment-gate": "node scripts/validation/deployment-gate.mjs",
    "demo:reset": "node scripts/acme/demo-reset.mjs",
    "demo:reset:dry-run": "node scripts/acme/demo-reset.mjs --dry-run",
    "test:demo-reset": "node --test scripts/acme/demo-reset.test.mjs",
    "test:installer:seed": "node --test scripts/installer/seed-demonstration.test.mjs",
    "copy:gate": "node scripts/validation/copy-style-gate.mjs",
    "demo:login:provision": "node scripts/acme/provision-demo-login.mjs",
    "a11y:gate": "node scripts/validation/accessibility-gate.mjs",
    "permissions:gate": "node scripts/validation/permission-matrix-gate.mjs",
    "markers:gate": "node scripts/validation/content-marker-gate.mjs",
    "docs:language:gate": "node scripts/validation/docs-language-gate.mjs",
    "product:docs:gate": "node scripts/validation/product-docs-gate.mjs",
    "link:gate": "node scripts/validation/link-gate.mjs",
    "routes:gate": "node scripts/validation/route-validation-gate.mjs",
    "logs:retention:gate": "node scripts/validation/log-retention-gate.mjs",
    "release:contract:gate": "node scripts/validation/release-contract-gate.mjs",
    "version:coherence:gate": "node scripts/validation/version-coherence-gate.mjs",
    "release:verify-deployed": "node scripts/validation/verify-deployed-version.mjs",
    "demo:reset:scoped": "node scripts/acme/demo-reset.mjs --tenant-slug=acme-eu-demo",
    "demo:provision-tenant": "node scripts/acme/provision-synthetic-tenant.mjs",
    "security:two-tenant-matrix": "node scripts/security/two-tenant-api-matrix.mjs",
    "security:supplier-isolation": "node scripts/security/supplier-isolation-matrix.mjs",
    "security:dast": "node scripts/validation/dast-scan.mjs",
    "test:ui-states": "node scripts/testing/ui-states-check.mjs",
    "orphan:check": "node scripts/validation/orphan-check.mjs",
    "orphan:reap": "node scripts/validation/orphan-check.mjs --reap"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "express": "^4.22.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "yaml": "2.8.4"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "esbuild@0.28.1": true
  }
}
