# SPDX-License-Identifier: Apache-2.0
# Copy to openppwr.env, keep root-owned mode 600, and never commit real values.
#
# The REPLACE_… values below are refused at startup, not merely discouraged. Compose checks only that a
# variable is non-empty, so a file copied unchanged used to start a deployment whose database password,
# bootstrap token and worker token were strings published in this repository. The API and the worker now
# refuse to start on a published placeholder, a value under 24 characters, or one made of too few distinct
# characters.
#
# Generate each with:  openssl rand -hex 32
# The installer does this for you and writes the file with mode 600.
OPENPPWR_COMPOSE_PROJECT=openppwr-community
OPENPPWR_IMAGE=ghcr.io/open-ppwr/openppwr:1.0.0
OPENPPWR_BIND_ADDRESS=127.0.0.1
OPENPPWR_WEB_PORT=31114
OPENPPWR_DB_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
OPENPPWR_RUNTIME_DATABASE_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
# The worker connects as its own database principal, not as the API's. Sharing one credential between
# them is what made every retention grant decorative, so the compose file refuses to start without this
# rather than falling back. It must differ from every other password here.
OPENPPWR_WORKER_DATABASE_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
OPENPPWR_BOOTSTRAP_TOKEN=REPLACE_WITH_64_HEX_CHARACTERS
OPENPPWR_WORKER_TOKEN=REPLACE_AFTER_BOOTSTRAP

# Demonstration sign-in. Leave unset on any deployment holding real data: setting it to true creates
# accounts with a password you have published. The password and mail domain are only read when it is
# enabled; the defaults are "demo" and "dummymail.example".
#
# Password sign-in also needs OPENPPWR_AUTH_DATABASE_PASSWORD below, and the environment reset needs
# OPENPPWR_MAINTENANCE_DATABASE_PASSWORD. Enabling the flag without them leaves both unavailable rather
# than falling back to the role that serves requests.
# OPENPPWR_DEMO_LOGIN=true
# OPENPPWR_DEMO_PASSWORD=
# OPENPPWR_DEMO_EMAIL_DOMAIN=

# Separate database principals for the two capabilities that do not belong to the request-serving role
# (migration 014): verifying a credential and issuing a session, and resetting the demonstration
# environment. Each is a distinct PostgreSQL login, and each needs its own password -- the installer
# refuses a password reused between principals, because a shared credential leaves the grants separated
# while the capability is not.
#
# Leave both unset on a deployment holding real data. Unset means the capability does not exist: the
# maintenance credential is then never loaded into the API process at all, and there is no reset to
# reach. This is the intended production configuration, not a degraded one.
#
# Generate each with: openssl rand -hex 32
# OPENPPWR_AUTH_DATABASE_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
# OPENPPWR_MAINTENANCE_DATABASE_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS

# Credential rotation (migration 035). The one privileged principal a deployment holding real data is
# meant to set, and the difference is worth stating rather than assuming: the two credentials above are
# authority by themselves -- one issues a session for any identity, the other deletes a tenant's data --
# whereas openppwr_rotation holds EXECUTE on the rotation function and nothing else, and that function
# resolves the acting identity from the credential presented on the request. A process holding this
# connection and no valid bearer token can rotate nothing.
#
# What it buys: POST /v1/identities/:id/rotate-credential, which replaces one identity's bearer token,
# returns the replacement once, ends that identity's sessions and records the change in the audit chain.
# Without it, a bearer token that leaks can only be replaced from the host with the migration credential.
#
# It must differ from every other password here. Generate with: openssl rand -hex 32
# OPENPPWR_ROTATION_DATABASE_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS

# Multi-host routing: map each surface to the hostname that serves it. Leave unset for the ordinary
# single-hostname self-hosted shape, where one host serves everything. An unmapped host is refused
# rather than falling back, so a hostname you did not list will not quietly reach a surface.
#
# Do not list a `www.` hostname here. A `www.` spelling of a host you did list is answered with a
# permanent redirect to it, so the site keeps one canonical hostname; listing both would publish the same
# pages under two of them. If your canonical hostname genuinely is the `www.` one, list that one instead
# and it is served directly.
# OPENPPWR_HOST_MAP=marketing:openppwr.example,app:app.openppwr.example,demo:demo.openppwr.example,docs:docs.openppwr.example,api:api.openppwr.example,status:status.openppwr.example,community:community.openppwr.example

# Which browser origins the API answers. Leave this unset unless you need it.
#
# The API ships an allowlist naming this project's own hostnames, and falls back to a same-origin test for
# everybody else -- your deployment's own front end is same-origin with your deployment's API, so on an
# ordinary self-host, mapped or single-domain, nothing needs setting here.
#
# Set it when the front end is served from an origin the API cannot see itself as: a separate hostname for
# the browser application, an additional alias you want answered, or a deployment where you would rather
# pin the answer explicitly than have it derived. Comma-separated, scheme included, no trailing slash --
# an origin is scheme + host + port, so `https://packaging.example` and `http://packaging.example` are two
# different values and only the one your users actually visit belongs here.
#
# A value here REPLACES the built-in list rather than adding to it. Include every origin you need, including
# `www.` if you serve it.
# OPENPPWR_CORS_ALLOWED_ORIGINS=https://packaging.example,https://www.packaging.example

# X-Forwarded-Host is a client-controllable header: trusting it by default let a request that reaches
# the origin directly, bypassing the reverse proxy, spoof the hostname and so which surface answers
# Set this only when a proxy you control is confirmed to be the sole edge-facing hop and
# to overwrite this header itself before forwarding. If anything can reach the origin without passing
# through that proxy, leave this unset: the application refuses to trust the header by default for
# exactly that reason.
# OPENPPWR_TRUST_X_FORWARDED_HOST=true

# CF-Connecting-IP is likewise client-controllable unless a proxy you control sets it. Set this only
# once you have confirmed every request truly arrives through that proxy.
# OPENPPWR_TRUST_CF_CONNECTING_IP=true

# --- Security alert routing -------------------------------------------------------------------
#
# The API writes a structured event for every refusal -- authentication failure, authorization denial,
# rate-limit trip, internal error -- to its own stdout, which the container log driver collects. These
# variables additionally POST those events to a destination you operate. All of them are unset here,
# and unset means off: nothing is sent, nothing is attempted, and the API says nothing about alerting.
# There is no default destination and there never will be one.
#
# What is sent is exactly the log line, byte for byte -- one JSON object per request, redacted by the
# same code that redacts the log. It carries the event code, the HTTP status, the method, the route
# pattern, a correlation id, and the acting identity and tenant as identifiers. It carries no bearer
# token, no password, no request body, no evidence filename and no raw URL: a raw path carries
# identifiers, and identifiers belong in the audit chain rather than in an operational alert.
#
# Delivery is fire-and-forget and cannot affect a request. If the destination is slow, unreachable, or
# answering an error, the request that produced the event is unaffected, the event is still written to
# stdout, and the alert is dropped. Every drop is counted and reported in the log as an
# `observability.alert.dropped` or `observability.alert.failed` record -- watch for those, because they
# are how you find out that alerting has stopped working. This is a deliberate fail-open choice: these
# events describe decisions the API has already made and already recorded, and refusing service because
# a notification could not be sent would turn any outage at the destination into an outage here.
#
# REACHABILITY. The api container is on internal networks only and has no outbound path by default. A
# destination inside the deployment works as shipped; a destination on the internet needs
# docker-compose.alerting.yml, which grants that one container egress. Read the note in that file
# before applying it.
#
# The URL is frequently a credential in its own right (a chat-platform webhook is nothing but a secret
# in a path). Treat this file accordingly -- it is already mode 600 -- and note that the application
# never writes the URL to the log, not even when reporting that it is unusable.
#
# The installer does not write these. Add them here by hand once you have chosen a destination.
#
# Required to enable anything. http and https only.
# OPENPPWR_ALERT_WEBHOOK_URL=https://alerts.example/hooks/openppwr
#
# Optional. Sent as `Authorization: Bearer <value>` to the destination, never in the payload and never
# to the log. Prefer this to a secret embedded in the URL where the destination supports it.
# OPENPPWR_ALERT_WEBHOOK_TOKEN=
#
# Lowest level that is worth waking someone for: debug, info, warn or error. Default: error, which is
# every 5xx. Set it to warn to include authentication failures, authorization denials and rate-limit
# trips -- and expect volume, because a not-found refusal is a warning too. Aggregation and
# de-duplication belong at the destination; this end sends one message per event and does not batch.
# OPENPPWR_ALERT_MIN_LEVEL=error
#
# How long one delivery may take before it is abandoned, in milliseconds. Default 2000, allowed 100 to
# 15000. It bounds the whole exchange, so a destination that accepts the connection and then never
# answers is abandoned on time too.
# OPENPPWR_ALERT_TIMEOUT_MS=2000
#
# How many deliveries may be outstanding at once. Default 16, allowed 1 to 256. Beyond it events are
# dropped rather than queued: an unbounded queue in front of a destination that has stopped answering
# grows until the process is killed, which loses far more than the alerts it was holding.
# OPENPPWR_ALERT_MAX_IN_FLIGHT=16
#
# A value here that cannot be honoured -- an unparseable URL, an unknown level, a timeout outside the
# range -- disables routing and says so once in the log, with a reason and without the URL. It does not
# quietly fall back to the defaults, because an operator who asked for something specific and silently
# got something else has no way to notice.
#
# --- The same events, by e-mail ---------------------------------------------------------------
#
# A second destination, independent of the webhook. Configure either, both, or neither. Both is a
# supported shape: a chat webhook for the people already watching a channel, a mailbox for the
# out-of-hours record. Absent means off, completely -- no connection is attempted and nothing is said.
#
# The body of every message is the same JSON record that goes to stdout and to the webhook, byte for
# byte. It is not reassembled for e-mail, which is what makes redaction a single place to get right.
#
# REACHABILITY, as for the webhook: the api container has no outbound path by default. A relay inside
# the deployment works as shipped; an external submission service needs docker-compose.alerting.yml.
#
# DO NOT point this at a published vulnerability-disclosure address. A real disclosure buried under 500
# automated notices is worse than no alerting at all. Use a mailbox that exists for machine alerts.
#
# Required to enable the transport. Hostname or address of the submission service.
# OPENPPWR_ALERT_SMTP_HOST=smtp.example.net
#
# Default depends on the TLS mode below: 587 for starttls, 465 for implicit, 25 for disabled.
# OPENPPWR_ALERT_SMTP_PORT=587
#
# starttls (default), implicit, or disabled.
#   starttls  -- plain connect, then upgrade. If the server stops advertising STARTTLS the message is
#                NOT sent in the clear; the delivery is refused, because a stripped capability is what
#                an attacker on the path produces.
#   implicit  -- TLS from the first byte (submissions, port 465).
#   disabled  -- no encryption. Only defensible for a relay inside the deployment, and credentials are
#                then refused outright rather than sent in the clear.
# Certificate verification is always on and cannot be turned off. A relay with a self-signed
# certificate must be reached over `disabled` on a network you already trust, without credentials.
# OPENPPWR_ALERT_SMTP_TLS=starttls
#
# Optional. AUTH PLAIN is used when the server offers it, AUTH LOGIN otherwise; a server offering
# neither is refused rather than fallen back from. These are never written to the log. Setting a
# username with OPENPPWR_ALERT_SMTP_TLS=disabled disables routing and says why -- a credential handed
# to a cleartext connection is handed to everything on the path.
# OPENPPWR_ALERT_SMTP_USERNAME=
# OPENPPWR_ALERT_SMTP_PASSWORD=
#
# Required. The envelope sender. Use an address the relay will accept from this host, or the messages
# are refused by the relay rather than by this software.
# OPENPPWR_ALERT_EMAIL_FROM=openppwr-alerts@example.net
#
# Required. One address, or several separated by commas, up to ten. A distribution address that fans
# out at the mail host is usually better than a list here.
# OPENPPWR_ALERT_EMAIL_TO=security-alerts@example.net
#
# How many alert e-mails may be sent in one hour. Default 60, allowed 1 to 10000; it can be raised but
# not removed. Beyond it messages are suppressed and counted, and the next message that does go out
# reports how many, in `X-OpenPPWR-Suppressed` and in its subject -- so "alerting went quiet" and
# "alerting was throttled" are distinguishable from the mailbox alone. There is no digest, deliberately:
# a digest means holding message content, and holding anything for a destination that has stopped
# answering is the unbounded state the fail-open design exists to avoid.
# OPENPPWR_ALERT_EMAIL_MAX_PER_HOUR=60
#
# A label for this deployment. It appears in the subject line and in X-OpenPPWR-Deployment so a mail
# rule can file by deployment and two stacks are distinguishable in one mailbox. Letters, digits, dot,
# underscore, colon and hyphen, up to 64 characters. Default: unnamed.
# OPENPPWR_ALERT_DEPLOYMENT=acme-prod-eu

# --- Log retention ------------------------------------------------------------------------------
#
# OPENPPWR_LOG_MAX_SIZE and OPENPPWR_LOG_MAX_FILE ARE GONE. If they are still set in this file they now
# do nothing at all. Every container logs to the host journal (journald), not to a Docker-managed file,
# because Docker's json-file driver evicts by size and has no age option: nothing expressible in a
# compose file discards a log for being thirty-one days old. What those two variables bought was a volume
# ceiling described as retention, which it never was.
#
# The retention period is now a journald setting, written by the installer to
# /etc/systemd/journald.conf.d/10-openppwr-retention.conf. It is HOST-WIDE: it governs every service on
# this machine, not only OpenPPWR's containers. That is the price of a real time bound, and the installer
# refuses to write it if the host already has a journald policy of its own rather than overwriting one.
#
#   sudo openppwr-installer journal-retention show     # what is actually in force right now
#   sudo openppwr-installer journal-retention apply    # write or re-write it (idempotent)
#
# READ THIS BEFORE QUOTING A NUMBER TO ANYONE. The shipped configuration promises
#
#     30 days OR 1 GB, whichever comes first
#
# and not "30 days". journald applies an age bound (MaxRetentionSec) and a size bound (SystemMaxUse)
# together, and whichever binds first wins. On a busy deployment 1 GB is reached before 30 days elapse
# and the journal holds less than 30 days. Both numbers are settable below; neither can be removed,
# because journald has a size default of its own (10% of the filesystem, capped at 4 GB) that applies
# whether or not you name one.
#
# A third bound you do not set here can shorten it further: SystemKeepFree, left at journald's default of
# 15% of the filesystem. journald uses the SMALLER of SystemMaxUse and "free space minus SystemKeepFree",
# so a disk that fills up lowers the ceiling and shortens the period, silently.
#
# The maximum age of a journal entry. Any systemd time unit: 30day, 4week, 720h.
# OPENPPWR_JOURNAL_RETENTION=30day
#
# The maximum disk the journal may occupy. Reached before the age bound on a busy deployment, and that is
# the case where the honest answer is "1 GB", not "30 days".
# OPENPPWR_JOURNAL_MAX_USE=1G
#
# How large one journal file may grow, and how long one may stay active. Both exist because journald
# deletes whole ARCHIVED files and never the active one, so an entry can outlive the retention period by
# up to one file's worth of time. 1day caps that overshoot at about a day; journald's own default of
# 1month would let an entry survive nearly two months under a 30day policy.
# OPENPPWR_JOURNAL_MAX_FILE_SIZE=128M
# OPENPPWR_JOURNAL_MAX_FILE_SEC=1day
#
# Escape hatches, both fatal-by-design if you need neither:
#   OPENPPWR_CONFIRM_JOURNAL_OVERRIDE=yes  proceed even though the host already configures journald
#   OPENPPWR_SKIP_JOURNAL_RETENTION=yes    leave journald alone; NO retention period is then enforced

# --- Database deadlines -----------------------------------------------------------------------
#
# EXTENDED and CHECKOUT now ship real defaults. INTERACTIVE is still absent by default, and absent
# means unbounded -- exactly what this deployment did before any of them existed. Leaving it unset
# changes nothing beyond the two defaults noted below.
#
# The previous version of this section cited the 32-record ACME fixture and refused to guess from it.
# That measurement has since been redone against a tenant of representative size: 3 000 packaging
# records, 60 suppliers, 60 materials, 400 components, 4 200 BOM lines, and 18 338 audit events built
# through real import, assessment, gap-remediation and reassessment writes rather than seeded as a row
# count (scripts/testing/synthetic-scale-tenant.mjs, measured by
# scripts/testing/deadline-scale-measurement.mjs). 3 000 is the middle of a stated representative range
# of 2 000-5 000 packaging records; no published product material states a packaging-record count for a
# real deployment.
#
# What that measurement supports differs by variable, and the difference is the point:
#
# EXTENDED bounds a single statement inside freezeReviewSnapshot, generateDossier and verifyAuditChain
# -- the operations that walk a whole tenant. Those three issue many cheap statements (18 354 of them at
# this tenant's size, 92% of the wall time in the per-event audit-hash recompute: median 0.124 ms, max
# 3.2 ms even at 50 000 events in a separate scaling run) and a handful of whole-snapshot ones that are
# not per-event, which topped out at 134 ms across two full runs. 2000 ms is roughly 15x that measured
# worst case: about 3x for headroom up to 5 000 packaging records, about 2x because only two full runs
# measured this statement directly, and a further ~2.5x because this measurement ran with no concurrent
# database load. Re-measure and raise this if your catalogue is substantially larger than a few
# thousand packaging records -- these statements scale with current catalogue size, not with audit
# history length.
# OPENPPWR_DB_EXTENDED_STATEMENT_TIMEOUT_MS=2000
#
# INTERACTIVE bounds a single statement in an ordinary authenticated read or write, and stays unset.
# This measurement instrumented the three extended operations named above, not the ordinary CRUD
# routes this class is meant to bound. Two things found in the process would have made guessing one
# anyway worse than merely unmeasured -- GET /v1/assessments and GET /v1/gaps returned every row with
# no LIMIT, and runAssessments (reached from POST /v1/gaps/:id/reassess too) looped the whole packaging
# catalogue inside one interactive-class transaction despite being exactly the "walks a whole tenant"
# shape the extended class exists for. Both are fixed as of 2026-08-01 -- the two routes now paginate
# (default page 100 rows, maximum 500) and runAssessments is reclassified as extended above -- but that
# does not manufacture the measurement this class still lacks. A number sized for a single row would
# still be a guess, so it stays unset until an ordinary CRUD route is actually timed.
# OPENPPWR_DB_INTERACTIVE_STATEMENT_TIMEOUT_MS=5000
#
# How long a request may wait for a free database connection. Read this one carefully even though it
# now ships a default. The pool holds ten connections, and a dossier -- or, as of 2026-08-01, a
# reassessment run -- keeps its connection for the whole of the work: measured at 0.4-3.2 s at this
# tenant's size, up to roughly 10 s by the audit-chain curve at 50 000 events, and longer still at a
# larger audit history. The checkout curve this measurement produced makes the conflict concrete rather
# than theoretical: at concurrency 10 (exactly filling the pool) checkout p95 was 205 ms; at 20, 356 ms;
# at 50, 1125 ms -- with every connection in that measurement released after only 250 ms, far shorter
# than a real extended operation holds one. Under real concurrency this value cannot distinguish a
# connection that will never arrive from one that is merely queued behind a busy neighbour -- it fails
# both, and only a deployment that knows its own concurrency can set a number that does.
#
# ---- OPERATOR NOTE, READ BEFORE RELYING ON THIS DEFAULT ----
# 30000 (30 seconds) is a conservative starting point, not a measurement of your deployment. It is
# roughly 3x the ~10 s an extended operation can hold a connection at the representative tenant size
# this repository measured -- enough headroom that an ordinary caller queued behind two or three such
# operations on a modestly busy deployment is not refused for no reason, while still being a real bound
# rather than "wait forever". It was never checked against this deployment's own concurrency, request
# mix or audit-history size. Raise it if you see checkout timeouts during ordinary use, especially soon
# after a freeze, dossier generation or reassessment; lower it if you would rather a stuck connection
# surface in under 30 seconds and are willing to risk failing a legitimate caller queued behind real
# extended-operation traffic. Measure your own checkout latency under your own concurrency before
# trusting either direction.
# OPENPPWR_DB_CHECKOUT_TIMEOUT_MS=30000
#
# How long the migration step may spend establishing its database connection. This one does have a
# default -- 30 seconds -- because it bounds a handshake and not any work: it cannot cancel a migration,
# only refuse to begin one against a database that accepted the connection and then went silent. Raise
# it if your database is slow to authenticate.
# OPENPPWR_DB_CONNECT_TIMEOUT_MS=30000
